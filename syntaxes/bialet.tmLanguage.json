{
	"name": "Wren",
	"scopeName": "source.wren",
	"patterns": [
		{
			"include": "#comments"
		},
		{
			"include": "#keywords"
		},
		{
			"include": "#classes"
		},
		{
			"include": "#operators"
		},
		{
			"include": "#strings"
		},
		{
			"include": "#inline-html-strings"
		},
		{
			"include": "#queries"
		}
	],
	"repository": {
		"comments": {
			"patterns": [
				{
					"name": "comment.line.double-slash.wren",
					"match": "//.*$"
				},
				{
					"name": "comment.block.wren",
					"begin": "/\\*",
					"end": "\\*/"
				}
			]
		},
		"keywords": {
			"patterns": [
				{
					"name": "keyword.reserved.wren",
					"match": "\\b(as|break|class|construct|continue|else|false|for|foreign|if|import|in|is|null|return|static|super|this|true|var|while)\\b"
				}
			]
		},
		"classes": {
			"patterns": [
				{
					"name": "support.type.wren",
					"match": "\\b(Bool|Class|Fiber|Fn|List|Map|Null|Num|Object|Range|Sequence|String|System|Request|Response|Cookie|Session|Json|Util|Config|Db|Http|Date|File|Markdown)\\b"
				},
				{
					"name": "support.function.query.wren",
					"match": "\\.\\s*(count|map|query|fetch|first|val|toNum|toBool|save|order|to)\\b"
				}
			]
		},
		"operators": {
			"patterns": [
				{
					"name": "keyword.operator.wren",
					"match": "\\.\\.\\.|\\.\\.|<<|>>|<=|>=|==|!=|&&|\\|\\||!|~|-|\\+|\\*|/|%|&|\\^|\\||<|>|\\?|:|="
				}
			]
		},
		"strings": {
			"name": "string.quoted.double.wren",
			"begin": "(\"|')",
			"end": "\\1",
			"patterns": [
				{
					"include": "#strings-interpolation"
				},
				{
					"name": "constant.character.escape.wren",
					"match": "\\\\."
				}
			]
		},
		"inline-html-strings": {
			"name": "string.quoted.html.wren",
			"begin": "<([a-z]+[a-z0-9]*)>",
			"end": "</\\1>",
			"contentName": "source.html",
			"patterns": [
				{
					"include": "#inline-html-interpolation"
				},
				{
					"include": "source.html"
				}
			]
		},
		"inline-html-interpolation": {
			"patterns": [
				{
					"name": "support.variable.interpolation.wren",
					"match": "{{.+}}",
					"patterns": [
						{
							"include": "#comments"
						},
						{
							"include": "#keywords"
						},
						{
							"include": "#classes"
						},
						{
							"include": "#operators"
						},
						{
							"include": "#strings"
						},
						{
							"include": "#inline-html-strings"
						}
					]
				}
			]
		},
		"strings-interpolation": {
			"patterns": [
				{
					"name": "keyword.interpolation.wren",
					"match": "%\\(.+?\\)"
				}
			]
		},
		"queries": {
			"name": "markup.italic.query.wren",
			"begin": "`",
			"end": "`"
		}
	}
}