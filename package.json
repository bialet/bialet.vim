{
  "name": "bialet-wren",
  "displayName": "Bialet (Wren)",
  "description": "Syntax highlighting for the Bialet framework, based on the Wren language.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [{
      "id": "wren",
      "aliases": ["Wren", "wren"],
      "extensions": [".wren"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "wren",
      "scopeName": "source.wren",
      "path": "./syntaxes/bialet.tmLanguage.json"
    }]
  }
}
